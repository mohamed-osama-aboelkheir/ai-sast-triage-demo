      ]
    },
    {
      "title": "4 · body → commentRepository.create",
      "description": "**Propagates:** the service passes the trimmed body unchanged, with the author's id from `req.user`.\n\n**Next →** inserted into `comments.body` (step 5).",
      "file": "src/services/commentService.js",
      "pattern": "commentRepository\\.create\\(user\\.id, (body)\\)",
      "selection": {
        "start": {
          "line": 13,
          "character": 65
        },
        "end": {
