      ]
    },
    {
      "title": "5 · Stored in comments.body",
      "description": "**Propagates:** stored as-is in `comments.body` with a parameterised INSERT. `db/init.sql:39-42` seeds three more rows, one of them containing an `<img>` with an inline event handler (seeded comment 2).\n\n**Next →** read back for every visitor (step 6).",
      "file": "src/repositories/commentRepository.js",
      "pattern": "VALUES \\(\\$1, \\$2\\)', \\[userId, (body)\\]",
      "selection": {
        "start": {
          "line": 16,
          "character": 85
        },
        "end": {
          "line": 16,
          "character": 89
        }
      },
      "commands": [
        "workbench.action.keepEditor"
      ]
    },
    {
      "title": "6 · Read back for every visitor",
      "description": "**Propagates:** `list()` reads every comment, newest first, for `GET /comments`. Nothing else writes `comments.body` (`grep -rn \"comments\" src` finds only these two queries).\n\n**Next →** rendered as Markdown by the service (step 7).",
      "file": "src/repositories/commentRepository.js",
      "pattern": "SELECT c\\.id, (c\\.body)",
      "selection": {
        "start": {
          "line": 8,
          "character": 19
