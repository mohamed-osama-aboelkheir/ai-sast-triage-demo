        "workbench.action.keepEditor"
      ]
    },
    {
      "title": "7 · comment.body → markdown.render(text)",
      "description": "**Propagates:** each row's body is passed to `markdown.render`, received as `text`.\n\n**Next →** `marked.parse(text)` (step 8).",
      "file": "src/services/commentService.js",
      "pattern": "markdown\\.render\\((comment\\.body)\\)",
      "selection": {
